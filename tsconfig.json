{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
    "exclude": ["node_modules", "src/lib/verify-levels.ts", "src/lib/verify-chapter4-dill.ts", "src/lib/verify-chapter4-tarragon.ts", "src/lib/verify-chapter4-oregano.ts", "src/lib/verify-chapter4-marjoram.ts", "src/lib/verify-chapter4-thyme.ts", "src/lib/verify-chapter4-rosemary.ts", "src/lib/verify-chapter4-mint.ts", "src/lib/verify-chapter4-catnip.ts", "src/lib/verify-chapter4-lavender.ts", "src/lib/verify-chapter4-chamomile.ts", "src/lib/verify-chapter4-bergamot.ts", "src/lib/verify-chapter4-jasmine.ts", "src/lib/verify-chapter4-magnolia.ts", "src/lib/verify-chapter4-hibiscus.ts", "src/lib/verify-chapter4-gardenia.ts"]
}
